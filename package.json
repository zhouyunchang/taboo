{
  "name": "taboo",
  "version": "0.1.0",
  "description": "taboo（禁制）— 开源自部署密钥管理平台。Monorepo 根包。",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "make -C apps/server-go build && ./apps/server-go/bin/taboo-server",
    "start:node": "npm run start -w @taboo/server",
    "dev": "node scripts/dev.js",
    "dev:server": "make -C apps/server-go run",
    "dev:server:node": "npm run dev -w @taboo/server",
    "dev:web": "npm run dev -w @taboo/web",
    "build": "npm run build -w @taboo/web",
    "types": "npm run types -w @taboo/web",
    "smoke": "make -C apps/server-go smoke",
    "smoke:node": "npm run smoke -w @taboo/server",
    "cli": "node apps/cli/taboo.js"
  }
}
