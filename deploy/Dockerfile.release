# GoReleaser supplies the two already-built Linux binaries in its build context.
FROM alpine:3.21
RUN apk add --no-cache curl \
    && adduser -D -u 10001 taboo \
    && mkdir -p /data && chown taboo:taboo /data
COPY taboo-server taboo-migrate /usr/local/bin/
ENV TABOO_PORT=7100 TABOO_DATA_DIR=/data TABOO_CORS_ORIGIN=*
VOLUME ["/data"]
EXPOSE 7100
USER taboo
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD curl -fsS http://127.0.0.1:7100/api/v1/readyz >/dev/null || exit 1
ENTRYPOINT ["taboo-server"]
