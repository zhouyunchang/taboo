# Template only. deploy.sh generates the real .env on dev122 (mode 0600) with random values.
TABOO_IMAGE=taboo:dev-<git-sha>
TABOO_HTTP_PORT=7100
TABOO_PUBLIC_ORIGIN=https://taboo.swetcc.com
TABOO_CORS_ORIGIN=https://taboo.swetcc.com
TABOO_DISABLE_REGISTER=false
# 32-byte hex encryption root (KEK). Back it up together with the database.
TABOO_MASTER_KEY=<openssl rand -hex 32>
TABOO_JWT_SECRET=<openssl rand -hex 32>
# Application control login on the shared PostgreSQL (NOSUPERUSER, NOBYPASSRLS).
TABOO_CONTROL_PASSWORD=<openssl rand -hex 32>
TABOO_DATABASE_URL=postgres://taboo_control:<TABOO_CONTROL_PASSWORD>@swetcc-postgres:5432/taboo?sslmode=verify-full&sslrootcert=/etc/taboo/pg-ca.crt

# --- Sign in with GitHub (optional; disabled while CLIENT_ID/SECRET are empty) ---
# GitHub OAuth App: Homepage URL https://taboo.swetcc.com
#                   Authorization callback URL https://taboo.swetcc.com/api/v1/auth/github/callback
# Put the real values into $DIR/.env on dev122 yourself (0600), then: ./taboo-ctl.sh reload
#TABOO_GITHUB_CLIENT_ID=<OAuth App Client ID>
#TABOO_GITHUB_CLIENT_SECRET=<OAuth App client secret>
# Who may sign in (at least one required, matched case-insensitively; comma separated):
#TABOO_GITHUB_ALLOWED_USERS=octocat,alice          # GitHub logins
#TABOO_GITHUB_ALLOWED_ORGS=my-org                  # active members of these orgs (adds read:org scope)
#TABOO_GITHUB_ALLOWED_TEAMS=my-org/platform        # active members of these org/team-slug
#TABOO_GITHUB_ALLOW_ANY=false                      # true = any GitHub account (not recommended)
# Unlinked GitHub accounts: false = must link from an existing Taboo account first (default)
#TABOO_GITHUB_AUTOCREATE=false
#TABOO_GITHUB_JOIN_ORG=                            # with AUTOCREATE: also add new users to this org slug
#TABOO_GITHUB_JOIN_ROLE=viewer                     # viewer | developer
